{
  "name": "meeting-assistant",
  "productName": "Meeting Assistant",
  "version": "0.4.0",
  "description": "Diarisation, transcription et compte rendu de réunions — application de bureau.",
  "private": true,
  "main": "main.js",
  "author": "Yele Consulting",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "dev:hot": "cross-env ELECTRON_DEV_URL=http://localhost:3000 electron .",
    "build:webapp": "cd ../webapp && npm run build",
    "build:python": "cd .. && pyinstaller build/backend.spec --noconfirm --clean",
    "build:assets": "cd .. && python scripts/prepare_assets.py",
    "build:all": "npm run build:python && npm run build:webapp",
    "dist": "electron-builder --win nsis",
    "release": "npm run build:all && npm run dist",
    "build:local": "npm run build:all && node build-app.js",
    "publish": "npm run build:all && node build-app.js --publish"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "tree-kill": "^1.2.2",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.yele.meeting-assistant",
    "productName": "Meeting Assistant",
    "copyright": "Copyright © 2026 Yele Consulting",
    "icon": "icon.png",
    "publish": {
      "provider": "github",
      "owner": "belguitarmelissazina",
      "repo": "meeting-assistant-releases",
      "private": true,
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build",
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "model_manifest.js",
      "downloader.js",
      "icon.png",
      "icon.ico"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../webapp/out",
        "to": "webapp-out",
        "filter": ["**/*"]
      },
      {
        "from": "../bin",
        "to": "assets/bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "MeetingAssistant-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meeting Assistant"
    }
  }
}
